{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "db-center",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "define": { "__dirname": "\"\"" },
  // One origin: the frontend build is served as static assets at `/`, the API at `/api`.
  // `deploy` and `vp run -t backend-worker#build` build the frontend first.
  "assets": {
    "directory": "../frontend/dist",
    // Unknown paths fall back to index.html so vue-router's history mode works on reload.
    "not_found_handling": "single-page-application",
    // Without this, the SPA fallback would answer unknown `/api/*` paths with index.html.
    "run_worker_first": ["/api/*"],
  },
  // No `database_id`: local development needs none, and `wrangler deploy` provisions the
  // database on first deploy and keeps it bound afterwards, so no account ID is tracked here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "db-center",
      "migrations_dir": "migrations",
    },
  ],
  // The daily cleanup (`scheduled` in src/worker.ts), at 03:00 JST.
  "triggers": {
    "crons": ["0 18 * * *"],
  },
  "observability": {
    "enabled": true,
  },
}
